// This is your Prisma schema file (Prisma 6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Platform {
  TWITTER
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  TELEGRAM
  VK
  DZEN
  TIKTOK
  YOUTUBE
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  TRIALING
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

/** Роли, которые можно назначить через инвайт (не OWNER). */
enum WorkspaceInviteRole {
  ADMIN
  EDITOR
  VIEWER
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio         String?
  avatar      String?
  brandVoice  String?
  tone        String?
  targetAudience String?
  preferences Json?
  
  brands      Brand[]
  generations Generation[]
  posts       Post[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete
  
  @@index([userId])
  @@index([deletedAt])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @default("")
  password      String?
  name          String?
  image         String?
  emailVerified DateTime?
  role          UserRole  @default(USER)
  
  profiles     Profile[]
  brands       Brand[]
  generations  Generation[]
  posts        Post[]
  subscriptions Subscription[]
  credentials  PlatformCredential[]
  sessions     Session[]

  ownedWorkspaces   Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  workspaceInvitesCreated WorkspaceInvite[] @relation("WorkspaceInviteCreator")
  userContentTemplates     UserContentTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete
  
  @@index([email])
  @@index([deletedAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /** JSON: editorsCanPublish (bool), прочие флаги workspace */
  settings  Json?

  members  WorkspaceMember[]
  invites  WorkspaceInvite[]
  brands   Brand[]
  userContentTemplates UserContentTemplate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([deletedAt])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  role WorkspaceMemberRole

  /** Делегирование от OWNER только для участников с ролью ADMIN */
  delegateBilling     Boolean @default(false)
  delegateFullAccess  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  email       String
  emailNorm   String
  role        WorkspaceInviteRole

  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?

  createdById String
  createdBy   User     @relation("WorkspaceInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId, emailNorm])
  @@index([expiresAt])
}

/** Пользовательские / командные шаблоны ниш (фаза 9+). */
model UserContentTemplate {
  id          String   @id @default(cuid())
  /** null = только у автора; иначе виден участникам workspace. */
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  creator     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  /** Снимок полей ниши (валидация в приложении). */
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId])
  @@index([createdById])
  @@index([deletedAt])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Brand {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  
  name        String
  description String?
  logo        String?
  website     String?
  industry    String?
  voice       String?
  tone        String?
  colors      String[]
  metadata    Json?
  
  generations Generation[]
  posts       Post[]
  credentials PlatformCredential[]
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete
  
  @@index([userId])
  @@index([workspaceId])
  @@index([profileId])
  @@index([isActive])
  @@index([deletedAt])
}

model Generation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  
  type        String
  prompt      String
  output      String?
  tokens      Int      @default(0)
  model       String
  status      GenerationStatus @default(PENDING)
  error       String?
  metadata    Json?
  
  posts       Post[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete
  
  @@index([userId])
  @@index([profileId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  generationId String?
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  
  platform     Platform
  content      String
  mediaUrls    String[]
  scheduledAt  DateTime?
  publishedAt  DateTime?
  status       ContentStatus @default(DRAFT)
  idempotencyKey String?
  publishAttempts Int @default(0)
  lastError    String?
  metadata     Json?
  
  credentialId String?
  credential   PlatformCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete
  
  @@index([userId])
  @@index([profileId])
  @@index([brandId])
  @@index([generationId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([idempotencyKey])
  @@index([deletedAt])
}

model PlatformCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  platform      Platform
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]
  
  posts         Post[]
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // Soft delete
  
  @@index([userId])
  @@index([brandId])
  @@index([platform])
  @@index([isActive])
  @@index([deletedAt])
  @@unique([userId, platform, brandId])
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tier                SubscriptionTier @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)
  
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePriceId       String?
  
  trialStartsAt       DateTime?
  trialEndsAt         DateTime?
  startsAt            DateTime?
  endsAt              DateTime?
  canceledAt          DateTime?
  
  generationLimit     Int  @default(100)
  postLimit           Int  @default(50)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}
