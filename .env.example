# Скопируйте в .env.local (локально) или задайте в панели хостинга (Vercel / VPS).
# Минимум для первого деплоя: DATABASE_URL + хотя бы один AI-ключ (см. ниже).

# --- Обязательно (приложение + БД) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Публичный URL сайта (для OpenRouter referer, редиректов OAuth, ссылок в письмах)
# NEXT_PUBLIC_APP_URL="https://your-domain.example"

# --- Сессии / шифрование (задайте в проде стойкие случайные значения) ---
# Ключ для зашифрованных токенов публикации (интеграции Telegram/VK)
# PUBLISH_TOKEN_ENCRYPTION_KEY="min-32-chars-random-hex-or-base64"

# Перцент для ссылок инвайта в workspace (если пользуетесь /join/workspace)
# WORKSPACE_INVITE_PEPPER="long-random-string"

# --- Генерация текста: минимум один провайдер ---
# OpenRouter (рекомендуется для мульти-моделей)
# OPENROUTER_API_KEY=""
# AI_DEFAULT_PROVIDER="openrouter"

# Либо отдельные API (см. src/lib/ai/providers/availability.ts)
# DEEPSEEK_API_KEY=""
# YANDEX_GPT_API_KEY="" / YANDEX_GPT_FOLDER_ID="" / YANDEX_GPT_MODEL_URI=""
# GIGACHAT_CLIENT_ID="" / GIGACHAT_CLIENT_SECRET=""

# --- Картинки (опционально) ---
# IMAGE_GEN_BACKEND="mock" | "openrouter" | "http" | ...
# S3_* — см. ниже; для дизайнера и ImageUploader

# --- Хранилище медиа (S3-совместимое): загрузки, визуальный редактор ---
# S3_ENDPOINT=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET=""
# S3_PUBLIC_URL="https://cdn.example.com"

# --- Автопубликация и cron ---
# CRON_SECRET="random-long-secret-for-publish-jobs-and-cron-routes"
# PUBLISH_MODE="sandbox" | "production"
# UPSTASH_* если используете очередь (см. docs проекта)

# --- VK OAuth (если нужна интеграция VK) ---
# VK_OAUTH_CLIENT_ID=""
# VK_OAUTH_CLIENT_SECRET=""
# VK_OAUTH_REDIRECT_URI="https://your-domain.example/api/platform-credentials/vk/callback"

# --- Прочее ---
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — только если включён биллинг (фаза 7)
# TELEGRAM_ENGAGEMENT_MOCK="true" — заглушка метрик Telegram до настройки Bot API
