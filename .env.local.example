DATABASE_URL=
AUTH_MODE=auto
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=your_key
S3_SECRET_KEY=your_secret
S3_BUCKET=user-media
S3_PUBLIC_URL=https://user-media.storage.yandexcloud.net
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL_URI=
DEEPSEEK_API_KEY=your_key_here
AI_DEFAULT_PROVIDER=deepseek
# Показать в UI генератора провайдера и модель ответа (для тестов). В режиме разработки включено без этого флага.
NEXT_PUBLIC_SHOW_AI_SOURCE=
# Базовый URL приложения для ссылок-приглашений в команду (HTTPS в проде)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Минимум 16 символов; используется только хеш SHA-256 токена в БД
WORKSPACE_INVITE_PEPPER=replace_with_long_random_secret
PUBLISH_MODE=sandbox
PUBLISH_PROXY_URL=http://127.0.0.1:8787/publish
PUBLISH_PROXY_SECRET=replace_with_long_random_secret
PUBLISH_TOKEN_ENCRYPTION_KEY=replace_with_long_random_secret

# --- Изображения для постов (хранение и ИИ) ---
# Где лежат картинки: отдельного «облака приложения» под файлы нет — строки кладутся в Post.mediaUrls в Postgres.
# Это либо https:// от вашего API генерации, либо data:image/… (mock / превью без бинарника на диске).
# При публикации Telegram: multipart для data URL, для https — передача URL в Bot API; прокси получает publishInlineImage (base64) если объём <= ~3 МБ.
#
# Что нужно от вас для подключения реальной генерации:
# 1) Выберите бэкенд: IMAGE_GEN_BACKEND=http и свой IMAGE_GEN_HTTP_URL (контракт: POST JSON { prompt, width, height } → JSON с полем url),
#    или дождитесь реализации YandexART под ваш ключ Yandex Cloud.
# 2) Ключи для HTTP: IMAGE_GEN_HTTP_KEY (Bearer), при необходимости поправьте IMAGE_GEN_HTTP_RESPONSE_URL_FIELD.
# 3) Для загрузки своих файлов с компьютера в объектное хранилище — S3_* ниже; без них загрузка файлов в UI отключена, остаётся ИИ и ручной URL (можно добавить позже).
#
# Генерация картинок (mock | http | yandex_art)
IMAGE_GEN_BACKEND=mock
IMAGE_GEN_HTTP_URL=
IMAGE_GEN_HTTP_KEY=
IMAGE_GEN_HTTP_RESPONSE_URL_FIELD=url
# yandex_art — заготовка в коде; нужны актуальные endpoint и IAM из Yandex Cloud