DATABASE_URL=
AUTH_MODE=auto
OPENROUTER_API_KEY=
# Текст OpenRouter: списки slug через запятую. FREE = только FREE; PRO/Enterprise = FREE затем PAID (порядок PAID — от дешёвых к дорогим).
AI_TEXT_MODELS_FREE=
AI_TEXT_MODELS_PAID=
# Изображения OpenRouter (IMAGE_GEN_BACKEND=openrouter): те же правила тарифов.
AI_IMAGE_MODELS_FREE=
AI_IMAGE_MODELS_PAID=
# Резерв: одна модель без каталога выше (если списки пусты — как раньше).
OPENROUTER_MODEL=
OPENROUTER_TEXT_MODEL=
# Рекомендуется OpenRouter: идентификация приложения
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# Изображения: IMAGE_GEN_BACKEND=openrouter и модель (по умолчанию flux-schnell; можно переопределить только OPENROUTER_IMAGE_MODEL)
OPENROUTER_IMAGE_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=your_key
S3_SECRET_KEY=your_secret
S3_BUCKET=user-media
S3_PUBLIC_URL=https://user-media.storage.yandexcloud.net
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL_URI=
# YandexART (IMAGE_GEN_BACKEND=yandex_art): URI модели, тот же Api-Key что YANDEX_GPT_API_KEY. Пример: art://<folder-id>/yandex-art/latest
YANDEX_ART_MODEL_URI=
# Необязательно: image/jpeg (по умолчанию) или image/png
# YANDEX_ART_MIME_TYPE=image/jpeg
DEEPSEEK_API_KEY=your_key_here
AI_DEFAULT_PROVIDER=deepseek
# Модерация: по умолчанию пробуется LLM (короткий JSON-ответ), иначе эвристика. MODERATION_USE_LLM=false — только эвристика/ключевые слова.
# MODERATION_USE_LLM=
# Провайдер для LLM-модерации (должен быть в AI / зарегистрирован). Пусто = effective default.
# MODERATION_AI_PROVIDER=openrouter
# Демо-метрики Telegram в аналитике (фаза 11); Bot API не отдаёт просмотры поста в канале.
# TELEGRAM_ENGAGEMENT_MOCK=true
# После успешной публикации в VK/Telegram — фоновый sync метрик (не блокирует очередь).
# ENGAGEMENT_SYNC_AFTER_PUBLISH=true
# Лимит постов за один вызов POST /api/analytics/engagement-cron (cron).
# ENGAGEMENT_CRON_BATCH_LIMIT=15
# Показать в UI генератора провайдера и модель ответа (для тестов). В режиме разработки включено без этого флага.
NEXT_PUBLIC_SHOW_AI_SOURCE=
# Базовый URL приложения для ссылок-приглашений в команду (HTTPS в проде)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Минимум 16 символов; используется только хеш SHA-256 токена в БД
WORKSPACE_INVITE_PEPPER=replace_with_long_random_secret
PUBLISH_MODE=sandbox
PUBLISH_PROXY_URL=http://127.0.0.1:8787/publish
PUBLISH_PROXY_SECRET=replace_with_long_random_secret
PUBLISH_TOKEN_ENCRYPTION_KEY=replace_with_long_random_secret

# --- Изображения для постов (хранение и ИИ) ---
# Где лежат картинки: отдельного «облака приложения» под файлы нет — строки кладутся в Post.mediaUrls в Postgres.
# Это либо https:// от вашего API генерации, либо data:image/… (mock / превью без бинарника на диске).
# При публикации Telegram: multipart для data URL, для https — передача URL в Bot API; прокси получает publishInlineImage (base64) если объём <= ~3 МБ.
#
# Что нужно от вас для подключения реальной генерации:
# 1) http: IMAGE_GEN_HTTP_URL (POST JSON { prompt, width, height } → JSON с полем url) + при необходимости IMAGE_GEN_HTTP_KEY.
# 2) yandex_art: YANDEX_GPT_API_KEY + YANDEX_ART_MODEL_URI, IMAGE_GEN_BACKEND=yandex_art
# 3) openrouter: OPENROUTER_API_KEY, IMAGE_GEN_BACKEND=openrouter
# 4) Для загрузки файлов в S3 — S3_* ниже
#
# Генерация картинок (mock | http | yandex_art | openrouter)
IMAGE_GEN_BACKEND=mock
IMAGE_GEN_HTTP_URL=
IMAGE_GEN_HTTP_KEY=
IMAGE_GEN_HTTP_RESPONSE_URL_FIELD=url