# Шаблон под продакшен на https://сенса.рф (Wispbyte + внешний PostgreSQL).
# Скопируйте в переменные окружения панели хостинга; секреты не коммитьте.
#
# Punycode домена (для DNS): xn--80ajyoc.xn--p1ai
# Канонический URL для приложения (рекомендуется):
NEXT_PUBLIC_APP_URL="https://сенса.рф"

NODE_ENV=production

# --- БД (обязательно) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- AI (минимум один провайдер) ---
OPENROUTER_API_KEY=""
AI_DEFAULT_PROVIDER="openrouter"

# OPENROUTER_HTTP_REFERER можно не задавать — подставится из NEXT_PUBLIC_APP_URL при необходимости

# --- Безопасность сессий и интеграций (задайте свои случайные строки в проде) ---
# PUBLISH_TOKEN_ENCRYPTION_KEY=""
# WORKSPACE_INVITE_PEPPER=""

# --- Cron / автопубликация ---
# CRON_SECRET=""
# PUBLISH_MODE="production"

# --- VK (если используете) ---
# VK_OAUTH_CLIENT_ID=""
# VK_OAUTH_CLIENT_SECRET=""
VK_OAUTH_REDIRECT_URI="https://сенса.рф/api/platform-credentials/vk/callback"

# --- S3 (опционально: загрузки, дизайнер) ---
# S3_ENDPOINT=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET=""
# S3_PUBLIC_URL=""
